<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>shelfcheck: third-party licences</title>
<style>
  :root { color-scheme: light dark; --ink:#101828; --muted:#475467; --rule:#e4e7ec; --code-bg:#f8fafc; }
  @media (prefers-color-scheme: dark) { :root { --ink:#e3e6eb; --muted:#a3adbb; --rule:#263044; --code-bg:#050a14; } }
  body { font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--ink); max-width: 60rem; margin: 0 auto; padding: 2rem 1rem; }
  h1 { font-size: 1.5rem; } h2 { font-size: 1.1rem; margin-top: 2rem; }
  p, li { color: var(--muted); }
  ul.crates { columns: 2; padding-left: 1.2rem; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--code-bg); border: 1px solid var(--rule); padding: 1rem; font-size: 0.8rem; }
  section { border-top: 1px solid var(--rule); }
</style>
</head>
<body>
<h1>Third-Party Licences</h1>
<p>shelfcheck is Apache-2.0. The release binary is built from the crates below, shelfcheck's own three crates included, under these licences. This file is generated by cargo-about from Cargo.lock; do not edit it by hand.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<section>
  <h2 id="{{id}}">{{name}}</h2>
  <p>Used by:</p>
  <ul class="crates">
  {{#each used_by}}
    <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
  </ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
